# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////data/trusttable.db
DATA_DIRECTORY=/data

# Local limits
MAX_FILE_SIZE_MB=100
MAX_ROWS=1000000
MAX_COLUMNS=500
MAX_WORKSHEETS=20
MAX_UNCOMPRESSED_WORKBOOK_MB=500
MAX_CELL_COUNT=50000000
ANALYSIS_RETENTION_HOURS=0
BACKGROUND_WORKER_COUNT=2

# LLM provider: disabled | mock | llama_cpp
# llama_cpp expects an OpenAI-compatible llama-server instance (llama.cpp)
# already running and serving LLM_MODEL at LLM_BASE_URL. LLM_MODEL has no
# default -- set it to the exact model identifier your llama-server reports
# (e.g. the baseline profile's Qwen3.5-4B-Q4_K_M, see docs/decision-log.md
# D-034/D-035). llama-server is inference infrastructure only -- run it with
# --no-webui on its own dedicated port (8081), distinct from TrustTable's
# own frontend port (8080); see docs/decision-log.md D-036 and
# docs/local-development.md.
LLM_PROVIDER=disabled
LLM_BASE_URL=http://host.docker.internal:8081
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT_SECONDS=120
LLM_SEND_SAMPLE_VALUES=false
LLM_MAX_SAMPLE_VALUES=10

# Security
PROMPT_INJECTION_DETECTION_ENABLED=true
MAX_TEXT_VALUE_LENGTH_FOR_ANALYSIS=10000
MAX_COLUMN_NAME_LENGTH=256
